model Session {
    id                  String      @id     @default(cuid())
    userId              String

    refreshTokenHash    String

    ipAddress           String?
    userAgent           String?
    deviceName          String?

    expiresAt           DateTime
    lastUsedAt          DateTime

    revokedAt           DateTime?
    createdAt           DateTime    @default(now())

    user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
    @@index([revokedAt])
}


model Token {
    id          String    @id @default(cuid())
    userId      String

    type        TokenType

    tokenHash   String

    expiresAt   DateTime

    usedAt      DateTime?
    createdAt   DateTime  @default(now())

    user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([type])
    @@index([expiresAt])

}