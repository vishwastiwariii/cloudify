model User {
  id            String      @id     @default(uuid())
  email         String      @unique
  username      String?     @unique

  password      String
  
  name          String

  avatar        String?

  isVerified    Boolean     @default(true)
  verifiedAt    DateTime? 

  storageLimit  BigInt      @default(2147483648) //2GB in bytes
  storageUsed   BigInt      @default(0) //Active files + trash files 

  deletedAt     DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sessions      Session[]
  tokens        Token[]
  folders       Folder[]
  files         File[]
  uploadSessions UploadSession[]

  @@index([deletedAt])
}