{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // Environment Settings
    // "bundler" resolution matches how this package is consumed: package.json
    // "exports" points straight at src/index.ts (no build step), so relative
    // imports don't need explicit file extensions the way node16/nodenext requires.
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "types": ["node"],
    "lib": ["esnext"],

    // Other Outputs
    // No build step here (package.json "exports" resolves straight to src/index.ts,
    // and "generated" sits outside src) so there's nothing to emit.
    "noEmit": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}
