# Reverse proxy for the Cloudify API on EC2.
#
# 1. Replace api.yourdomain.com with your real subdomain (must already have
#    an A record pointing at this instance's public IP).
# 2. Copy to /etc/nginx/sites-available/cloudify-api, then:
#      sudo ln -s /etc/nginx/sites-available/cloudify-api /etc/nginx/sites-enabled/
#      sudo nginx -t && sudo systemctl reload nginx
# 3. Get a cert (this rewrites the file to add the HTTPS server block + redirect):
#      sudo certbot --nginx -d api.yourdomain.com

server {
    listen 80;
    server_name api.yourdomain.com;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
